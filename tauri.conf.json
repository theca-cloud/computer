{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Theca",
  "identifier": "rs.theca.computer",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5194",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "features": ["gui"]
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "linux": {
      "deb": {
        "depends": ["fuse3"]
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "ci/installer.nsh"
      }
    },
    "macOS": {
      "files": {
        "PlugIns/ThecaDrive.appex": "target/appex/ThecaDrive.appex"
      },
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
