<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app is not sandboxed: only the app group the drive's extension holds
     too (@GROUP@, made by ci/mac-app.sh from the Team ID), the folder they
     meet in, so that the app never reaches into the extension's sandbox
     (theca/computer#118). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>@GROUP@</string>
	</array>
</dict>
</plist>
